# 应用标题
VITE_APP_TITLE=管理系统
VITE_APP_DESC=管理系统描述

# 基础路径
VITE_BASE_URL=/

# 路由模式
VITE_AUTH_ROUTE_MODE=static
VITE_CONSTANT_ROUTE_MODE=static
VITE_ROUTER_HISTORY_MODE=history
VITE_ROUTE_HOME=home

# 后端服务地址
VITE_SERVICE_BASE_URL=http://localhost:8000
VITE_OTHER_SERVICE_BASE_URL={}

# HTTP 代理配置
VITE_HTTP_PROXY=Y
VITE_PROXY_LOG=N

# 服务响应码配置
VITE_SERVICE_SUCCESS_CODE=0000
VITE_SERVICE_LOGOUT_CODES=1000,1001,1002
VITE_SERVICE_MODAL_LOGOUT_CODES=1003
VITE_SERVICE_EXPIRED_TOKEN_CODES=1004,1005

# 图标配置
VITE_ICON_PREFIX=icon
VITE_ICON_LOCAL_PREFIX=icon-local
VITE_MENU_ICON=mdi:menu

# 其他配置
VITE_SOURCE_MAP=N
VITE_AUTOMATICALLY_DETECT_UPDATE=N
VITE_STORAGE_PREFIX=soybean
VITE_STATIC_SUPER_ROLE=R_SUPER
