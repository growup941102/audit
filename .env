# 时区
TZ=Asia/Shanghai

# 数据库（MySQL 容器）
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=audit_agent
MYSQL_PORT_EXPOSE=3306
# 同一 docker compose 网络内建议使用 db；远程库请改成实际地址
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=CHANGE_ME_MYSQL_APP_PASSWORD

# 后端（Django 容器）
BACKEND_PORT=8000
FRONTEND_PORT=80
DEBUG=0
SECRET_KEY=CHANGE_ME_DJANGO_SECRET_KEY
MINIO_ENABLED=0
# 连接远程数据库时建议改成 0，避免容器启动时执行 migrate/init_auth_data 写入远程库
DJANGO_DB_INIT=1

# 首次启动初始化管理员（init_auth_data）
INIT_CREATE_SUPERUSER=1
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
INIT_ADMIN_EMAIL=admin@example.com
